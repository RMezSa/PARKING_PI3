[Unit]
Description=Telegram Parking Bot Service
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/telegram
ExecStart=/usr/bin/python3 /home/pi/telegram/parking_bot.py
Restart=always
RestartSec=10

# Logging
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
